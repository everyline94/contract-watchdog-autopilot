# Supabase: lido por src/lib/db/cliente.ts, que nada chama ainda (o MVP nao tem banco).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Relogio da demo pelo ambiente, ex: 2026-12-02T09:00:00-03:00 (ver README).
DEMO_NOW=
# Chave do AI Gateway da Vercel. O SDK `ai` le sozinho; so o motor "gateway" usa.
AI_GATEWAY_API_KEY=
# Vercel Blob, storage privado do PDF: planejado em docs/ARQUITETURA.md, nada le ainda.
BLOB_READ_WRITE_TOKEN=
# Cron fail-closed: sem isso o monitor devolve 401. Em dev use qualquer string.
CRON_SECRET=
# Com token setado, /api/extrair exige Authorization: Bearer <token>.
# Sem token, na Vercel a rota fica desligada; local segue livre.
EXTRAIR_TOKEN=
# DEMO_PALCO=1 libera o header x-demo-now num deploy de demonstracao.
DEMO_PALCO=
# Motor de leitura: "claude-code" roda o `claude -p` local, "gateway" usa o
# AI Gateway da Vercel. Vazio: gateway na Vercel, claude-code fora dela.
MOTOR_LEITURA=
